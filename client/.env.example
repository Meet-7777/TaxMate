# Copy this file to .env and fill in your values.
# Never commit .env — only .env.example is tracked.

# API base URL — where the Go server is reachable from the browser.
# Dev: leave as "/" (Vite proxy handles it).
# Production: set to your API origin, e.g. https://api.taxmate.com.au
VITE_API_BASE_URL=/

# Go server origin used by Vite's dev proxy.
VITE_API_PROXY_TARGET=http://localhost:8080
